@using GolBet.Entities.Enums
@model IEnumerable<GolBet.Services.DTOs.MatchDto>

@{
    ViewData["Title"] = "Cartelera";
    MatchStatus? currentStatus = ViewBag.CurrentStatus;
    string? currentSearch = ViewBag.CurrentSearch;
    var hasSearch = !string.IsNullOrEmpty(currentSearch);

    string FilterClass(MatchStatus? value) => currentStatus == value ? "btn-success" : "btn-outline-success";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>⚽ Cartelera de partidos</h1>
    @if (User.IsInRole(Roles.Admin))
    {
        <a class="btn btn-success" asp-action="Create">+ Nuevo partido</a>
    }
</div>

@* GET: el navegador arma /Matches?search=...&status=... y la búsqueda sobrevive a F5 y se puede compartir. *@
<form asp-action="Index" method="get" class="row g-2 align-items-end mb-3" role="search">
    <div class="col-sm-8 col-md-6">
        <label for="search" class="form-label">Buscar por equipo</label>
        <input type="search" id="search" name="search" value="@currentSearch"
               class="form-control" placeholder="Ej: nacional" maxlength="80" />
    </div>
    @if (currentStatus.HasValue)
    {
        @* Conserva el filtro de estado activo al hacer una nueva búsqueda. *@
        <input type="hidden" name="status" value="@currentStatus" />
    }
    <div class="col-auto">
        <button type="submit" class="btn btn-success">Buscar</button>
        @if (hasSearch)
        {
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-status="@currentStatus">Limpiar</a>
        }
    </div>
</form>

@* Cada filtro lleva también la búsqueda activa (asp-route-search se omite si está vacía). *@
<div class="btn-group mb-4" role="group">
    <a class="btn @FilterClass(null)" asp-action="Index" asp-route-search="@currentSearch">Todos</a>
    <a class="btn @FilterClass(MatchStatus.Scheduled)" asp-action="Index" asp-route-status="Scheduled" asp-route-search="@currentSearch">Programados</a>
    <a class="btn @FilterClass(MatchStatus.InProgress)" asp-action="Index" asp-route-status="InProgress" asp-route-search="@currentSearch">En Juego</a>
    <a class="btn @FilterClass(MatchStatus.Finished)" asp-action="Index" asp-route-status="Finished" asp-route-search="@currentSearch">Finalizados</a>
</div>

@if (!Model.Any())
{
    if (hasSearch)
    {
        <div class="text-center py-5">
            <h2 class="h4">🔍 No hay partidos para el equipo “@currentSearch”.</h2>
            <p class="text-muted">Revisa el nombre o prueba con otra parte del nombre del equipo.</p>
            <a class="btn btn-success" asp-action="Index">Volver a la cartelera de partidos</a>
        </div>
    }
    else
    {
        <p class="text-muted">No hay partidos para este filtro.</p>
    }
}

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @foreach (var match in Model)
    {
        var (badgeClass, statusLabel) = match.Status switch
        {
            MatchStatus.Scheduled => ("bg-secondary", "Programado"),
            MatchStatus.InProgress => ("bg-warning text-dark", "En Juego"),
            MatchStatus.Finished => ("bg-success", "Finalizado"),
            _ => ("bg-secondary", match.Status.ToString())
        };

        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge @badgeClass">@statusLabel</span>
                        <small class="text-muted">@match.Date.ToString("dd/MM/yyyy HH:mm")</small>
                    </div>

                    <div class="d-flex justify-content-between align-items-center text-center">
                        <div class="flex-fill">
                            @if (!string.IsNullOrWhiteSpace(match.HomeTeamCrestUrl))
                            {
                                <img src="@match.HomeTeamCrestUrl" alt="@match.HomeTeamName" style="height:48px" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center mx-auto"
                                     style="width:48px;height:48px;font-weight:bold;">FC</div>
                            }
                            <div class="small mt-1">@match.HomeTeamName</div>
                        </div>

                        <div class="px-2 fw-bold">
                            @if (match.Status == MatchStatus.Finished)
                            {
                                <span>@match.HomeGoals - @match.AwayGoals</span>
                            }
                            else
                            {
                                <span>vs</span>
                            }
                        </div>

                        <div class="flex-fill">
                            @if (!string.IsNullOrWhiteSpace(match.AwayTeamCrestUrl))
                            {
                                <img src="@match.AwayTeamCrestUrl" alt="@match.AwayTeamName" style="height:48px" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center mx-auto"
                                     style="width:48px;height:48px;font-weight:bold;">FC</div>
                            }
                            <div class="small mt-1">@match.AwayTeamName</div>
                        </div>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between text-center small mb-3">
                        <div><div class="fw-bold">1</div>@match.HomeOdds.ToString("0.00")</div>
                        <div><div class="fw-bold">X</div>@match.DrawOdds.ToString("0.00")</div>
                        <div><div class="fw-bold">2</div>@match.AwayOdds.ToString("0.00")</div>
                    </div>

                    <a class="btn btn-sm btn-outline-secondary w-100" asp-action="Detail" asp-route-id="@match.Id">Ver detalle</a>
                </div>
            </div>
        </div>
    }
</div>
