@using GolBet.Entities.Enums
@model GolBet.Services.DTOs.MatchDetailDto

@{
    ViewData["Title"] = $"{Model.HomeTeamName} vs {Model.AwayTeamName}";

    var statusLabel = Model.Status switch
    {
        MatchStatus.Scheduled => "Programado",
        MatchStatus.InProgress => "En Juego",
        MatchStatus.Finished => "Finalizado",
        _ => Model.Status.ToString()
    };
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-controller="Matches" asp-action="Index">Cartelera</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.HomeTeamName vs @Model.AwayTeamName</li>
    </ol>
</nav>

<div class="card shadow-sm">
    <div class="card-body text-center">
        <span class="badge bg-secondary mb-3">@statusLabel</span>
        <p class="text-muted">@Model.Date.ToString("dddd dd 'de' MMMM 'de' yyyy, HH:mm")</p>

        <div class="d-flex justify-content-center align-items-center gap-5 my-4">
            <div>
                @if (!string.IsNullOrWhiteSpace(Model.HomeTeamCrestUrl))
                {
                    <img src="@Model.HomeTeamCrestUrl" alt="@Model.HomeTeamName" style="height:96px" />
                }
                else
                {
                    <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center mx-auto"
                         style="width:96px;height:96px;font-weight:bold;font-size:1.5rem;">FC</div>
                }
                <h5 class="mt-2">@Model.HomeTeamName</h5>
            </div>

            <div class="fs-2 fw-bold">
                @if (Model.Status == MatchStatus.Finished)
                {
                    <span>@Model.HomeGoals - @Model.AwayGoals</span>
                }
                else
                {
                    <span>vs</span>
                }
            </div>

            <div>
                @if (!string.IsNullOrWhiteSpace(Model.AwayTeamCrestUrl))
                {
                    <img src="@Model.AwayTeamCrestUrl" alt="@Model.AwayTeamName" style="height:96px" />
                }
                else
                {
                    <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center mx-auto"
                         style="width:96px;height:96px;font-weight:bold;font-size:1.5rem;">FC</div>
                }
                <h5 class="mt-2">@Model.AwayTeamName</h5>
            </div>
        </div>

        <div class="row text-center mb-4">
            <div class="col">
                <div class="fw-bold">Gana Local</div>
                <div class="fs-5">@Model.HomeOdds.ToString("0.00")</div>
            </div>
            <div class="col">
                <div class="fw-bold">Empate</div>
                <div class="fs-5">@Model.DrawOdds.ToString("0.00")</div>
            </div>
            <div class="col">
                <div class="fw-bold">Gana Visitante</div>
                <div class="fs-5">@Model.AwayOdds.ToString("0.00")</div>
            </div>
        </div>

        <p class="text-muted">@Model.BetsCount apuesta(s) registrada(s)</p>

        @if (Model.Status == MatchStatus.Scheduled)
        {
            if (User.IsInRole(Roles.Bettor))
            {
                <hr />
                <h5 class="mb-3">🎯 Haz tu apuesta</h5>

                @* Cada botón de cuota envía su propio valor de Pick (Home, Draw o Away). *@
                <form asp-controller="Bets" asp-action="Place" method="post" class="col-md-8 mx-auto">
                    <input type="hidden" name="MatchId" value="@Model.Id" />

                    <div class="input-group mb-3">
                        <span class="input-group-text">Monto</span>
                        <input name="Amount" type="number" min="1" step="1" value="1000" required class="form-control" />
                        <span class="input-group-text">FutCoins</span>
                    </div>

                    <div class="row g-2">
                        <div class="col">
                            <button type="submit" name="Pick" value="Home" class="btn btn-outline-success w-100">
                                1 · @Model.HomeOdds.ToString("0.00")
                            </button>
                        </div>
                        <div class="col">
                            <button type="submit" name="Pick" value="Draw" class="btn btn-outline-success w-100">
                                X · @Model.DrawOdds.ToString("0.00")
                            </button>
                        </div>
                        <div class="col">
                            <button type="submit" name="Pick" value="Away" class="btn btn-outline-success w-100">
                                2 · @Model.AwayOdds.ToString("0.00")
                            </button>
                        </div>
                    </div>
                    <small class="text-muted d-block mt-2">Escribe el monto y haz clic en la cuota que quieres apostar.</small>
                </form>
            }
            else if (User.Identity?.IsAuthenticated != true)
            {
                <a class="btn btn-success btn-lg" asp-controller="Account" asp-action="Login"
                   asp-route-returnUrl="@Url.Action("Detail", "Matches", new { id = Model.Id })">Inicia sesión para apostar</a>
            }
        }
    </div>

    @if (User.IsInRole(Roles.Admin))
    {
        <div class="card-footer d-flex justify-content-end gap-2">
            <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
            <form asp-action="Deactivate" asp-route-id="@Model.Id" method="post"
                  onsubmit="return confirm('¿Desactivar este partido? Dejará de verse en la cartelera.');">
                <button type="submit" class="btn btn-outline-danger">Desactivar</button>
            </form>
        </div>
    }
</div>
