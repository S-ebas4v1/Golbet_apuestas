@model IEnumerable<GolBet.Services.DTOs.TeamDto>

@{
    ViewData["Title"] = "Equipos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>🛡️ Equipos</h1>
    <a class="btn btn-success" asp-action="Create">+ Nuevo equipo</a>
</div>

@if (!Model.Any())
{
    <p class="text-muted">No hay equipos activos.</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th style="width:64px"></th>
                <th>Nombre</th>
                <th>Ciudad</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var team in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(team.CrestUrl))
                        {
                            <img src="@team.CrestUrl" alt="@team.Name" style="height:40px" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center"
                                 style="width:40px;height:40px;font-weight:bold;font-size:.8rem;">FC</div>
                        }
                    </td>
                    <td class="fw-bold">@team.Name</td>
                    <td>@team.City</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@team.Id">Editar</a>
                        <form asp-action="Deactivate" asp-route-id="@team.Id" method="post" class="d-inline"
                              onsubmit="return confirm('¿Desactivar el equipo @team.Name?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Desactivar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
